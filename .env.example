# Example values only. Replace these with credentials for your WordPress site.
WORDPRESS_SITE_URL=https://www.example.com
WORDPRESS_USERNAME=wordpress-integration-user
WORDPRESS_APPLICATION_PASSWORD=replace-with-generated-application-password

# Optional HTTP behavior. Defaults: 20, 3, and 0.5 respectively.
YOAST_HTTP_TIMEOUT_SECONDS=20
YOAST_MAX_RETRIES=3
YOAST_RETRY_BACKOFF_SECONDS=0.5
